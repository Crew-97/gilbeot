// =============================================================
// 길벗 (Gilbeot) — ERD
//
// 문서 버전: v3.0
// 정본 기획서: docs/길벗_서비스_기획서_v2.4.md
// 선행 문서:   docs/기능명세서.md (화면 S-01~S-10, 기능 ID)
// 공통 규칙:   AGENTS.md
//
// 이 파일과 기획서가 충돌하면 기획서를 우선하고 팀에 알린다.
// 이름의 정본은 이 파일이다. 필드명을 코드에서 임의로 바꾸지 않는다.
//
// -------------------------------------------------------------
// 이 ERD의 위치
// -------------------------------------------------------------
// 해커톤 MVP에는 DB가 없다 (data/*.json 시드 + 인메모리, AGENTS.md 기술 스택).
// 따라서 이 ERD는 두 가지 역할을 동시에 한다.
//
//   (A) 시드 JSON과 인메모리 상태의 구조 정본  ← 당일 사용
//   (B) 실서비스 전환 시의 스키마 설계         ← 발표·보고서용
//
// database_type을 지정하지 않은 이유: 당일 DB를 쓰지 않으므로
// 특정 DBMS를 확정하면 없는 사양을 만드는 것이 된다. 타입은 일반 표기다.
//
// -------------------------------------------------------------
// 표기 규칙
// -------------------------------------------------------------
//   근거      : 기획서 v2.4의 위치. 근거 없는 필드는 두지 않는다
//   18-확정 N : 기획서 18장 MVP 정책 확정사항 표의 N번 항목 (#1~#27, v2.4에서 #23~#27 신설)
//   18-N      : 기획서 18장의 하위 절 (18-1~18-7). 둘 다 존재하므로 구분해 쓴다
//   [캐시]    : 파생값 캐시. 정본이 따로 있으므로 불일치하면 정본이 옳다
//   [Mock]    : 카카오 T 트럭커 연동 전제 데이터. MVP에서는 전량 가짜
//   [실동작]  : 길벗이 실제로 생성·변경하는 데이터
//   [제안]    : AGENTS.md 엔티티 목록에 없어 이 문서에서 추가 제안하는 것
//   [미정: N] : 결정 권한이 팀에 있는 항목. 기능명세서 14장 번호와 이어진다
//
// 명명 규칙 (AGENTS.md): DB·시드 JSON은 snake_case 단수형.
// FE 상태는 camelCase이며 변환은 lib/dataSource.js에서 1회만 수행한다.
// 상태 문자열은 코드·DB에서 소문자, 문서 표기는 대문자 허용.
// =============================================================


Project gilbeot {
  Note: '''
  화물기사의 도착지 주변 현장 경험(암묵지)을 AI 인터뷰로 수집·구조화해
  다른 기사에게 연결하는 장소 기반 지식 공유 서비스.

  경로 추천 / 도로 정보 / 실시간 교통 / 내비게이션은 서비스 범위 밖이다.
  위치 데이터는 장소 방문·정차 식별과 인터뷰 후보 선정, 운행 중 현재 위치 기준
  암묵지 제공, 도착지 도달 판정에만 사용한다 (v2.4에서 목적이 확대됐다).
  (근거: 기획서 1, 18-확정 12, 18-확정 22, 26)

  ── v2.4 운행 여정이 스키마에 남는 지점
  출발지·도착지 입력 → 도착지 브리핑 → 도착지 확정(지도 요약 정보) → 운행 시작
  → 운행 중 현재 위치 기반 조회 → 도착지 도달(운행 종료) → AI 인터뷰

    출발지·도착지 입력   dispatch.origin_* / dispatch.center_id
    도착지 브리핑        저장 대상 아님. knowledge_card를 카테고리별로 정리해 보여주는 화면
    지도 요약 정보       freight_center.logistics_cost / avg_stay_minutes / handled_items
    운행 시작            dispatch.started_at
    운행 중 조회         저장 대상 아님. 현재 위치는 트럭커가 주는 실시간 값이다
    도착지 도달          dispatch.ended_at  ← 인터뷰 생성·노출 트리거

  브리핑과 운행 중 조회는 저장 구조를 늘리지 않는다. 둘 다 이미 있는
  knowledge_card를 다른 기준(도착 센터 / 현재 위치)으로 고르는 조회 화면이기 때문이다.
  '''
}


// =============================================================
// ENUM
//
// AGENTS.md 규칙: 기존 값 삭제·개명 금지, 추가만 가능.
// route_deviation은 v2.3에서 서비스 범위 제외 — 신규 ERD에 넣지 않는다.
// =============================================================

// 근거: 기획서 8-1, 18-11.
// place.category에도 재사용하되 center_tip은 쓰지 않는다.
Enum card_category {
  center_tip [note: '화물센터·상하차 팁']
  gas        [note: '주유소']
  food       [note: '식당']
  rest       [note: '휴게소·쉼터']
}

// 근거: 기획서 18-확정 4, 18-2. 상태 전이는 기능명세서 8-2 참조.
Enum card_status {
  draft     [note: 'AI 구조화 완료, 기사 확인 전. 목록 노출 안 함']
  published [note: '기사 확인·게시 완료. 기사 목록에 노출되는 유일한 상태']
  review    [note: '부정 평가 임계값 초과로 자동 전환. 관리자 검토 대상']
  hidden    [note: '관리자 비공개']
  deleted   [note: 'Soft Delete. 물리 삭제하지 않는다']
}

// 근거: 기획서 7-1, 18-13.
// 이것은 "인터뷰 후보 선정 기준"이지 "인터뷰 노출 트리거"가 아니다.
// 노출 트리거는 도착지 도달에 따른 운행 종료이며 dispatch.ended_at에 기록한다
// (v2.4에서 도달 기준으로 재정의됐다. 아래 dispatch 참조).
Enum trigger_type {
  repeat_visit [note: '도착지 주변 장소 반복 방문']
  repeat_stop  [note: '도착지 주변 장소 반복 정차']
}

// 근거: 기획서 10-2
Enum eval_value {
  helpful     [note: '도움됐어요']
  not_helpful [note: '도움 안 됐어요']
}

// 근거: 기획서 9-1, 18-확정 2. 이 4개가 전부다. 다른 적립·차감 사유를 추가하지 않는다.
// extra_reward라는 명칭은 ERD 담당 확정 전 제안값이다 (AGENTS.md 데이터 모델 절).
Enum point_tx_type {
  signup_bonus     [note: '최초 가입 +100P (최초 1회)']
  interview_reward [note: '유효한 암묵지 기여 +100P (인터뷰 1회당 1번)']
  extra_reward     [note: '추가 음성 기여 보너스 +10P/건 (인터뷰당 최대 +50P)']
  unlock_spend     [note: '지식 카드 1건 해금 -10P (최초 1회, 환불 없음)']
}

// [제안] card_relation 테이블용. 근거: 기획서 7-3 4단계, 11-2
Enum relation_type {
  similar  [note: '표현은 달라도 같은 현장 사실 — 교차 검증으로 연결']
  conflict [note: '기존 주장과 크게 충돌 — 별도 카드로 보존 후 관리자 검토']
}


// =============================================================
// 1. driver — 화물운송기사
// =============================================================

Table driver {
  id             varchar   [pk, note: 'MVP는 시드 JSON의 문자열 id. 실서비스는 uuid/bigint']
  name           varchar   [not null, note: '기사 이름. 화면 표시용']
  age            int       [null, note: '기획서 페르소나(김영수 56세 / 박철수 58세) 반영. 시연 화면 표시용']
  career_years   int       [null, note: '경력 연차. 페르소나 A(3년)와 B(15년)의 대비가 서비스 설명의 근거다']
  base_region    varchar   [null, note: '주 활동 권역. 예: 수도권, 영남권']
  point_balance  int       [not null, default: 0, note: '[캐시] 포인트 잔액. 정본은 point_transaction의 amount 합계. 근거: 기획서 9-1']
  created_at     timestamp [not null, note: '가입 시각. signup_bonus 지급 기준']
  deleted_at     timestamp [null, note: 'Soft Delete. 근거: 기획서 18-확정 7']

  Note: '''
  [실동작]
  MVP는 인증이 없으므로 단일 시연 기사 + 시드 카드 작성자용 기사들로 구성한다.
  시드 카드도 driver를 참조해야 "자기 카드는 평가 불가" 규칙이 성립한다
  (근거: 기획서 13-4 마지막 문단).

  point_balance는 캐시다. 화면은 이 값을 읽되, 정합성 의심 시
  point_transaction 합계를 정본으로 본다. 갱신은 lib/store.js에서만 한다.
  '''
}


// =============================================================
// 2. freight_center — 화물센터 (도착지)
// =============================================================

Table freight_center {
  id               varchar   [pk]
  name             varchar   [not null, note: '센터명. 예: 양산 ICD']
  address          varchar   [null, note: '주소 표기. 목록 화면(S-02)에서 센터 구분용. 시드는 시연용 근사 주소다']
  lat              decimal   [not null, note: '지도 마커 좌표. 근거: 기획서 13-2']
  lng              decimal   [not null, note: '지도 마커 좌표']
  visit_count      int       [not null, default: 0, note: '[Mock][캐시] 기사 방문 횟수. 관리자 화면 ADM-02 전용. 근거: 기획서 12']
  logistics_cost   int       [null, note: '[Mock] 도착지 요약 정보 1/3 — 물류 원가. 단위는 원이며 이 센터 1회 운송의 평균 물류 원가다 (2026-08-13 확정, 구 미정 29). 근거: 기획서 8-5, 18-확정 26']
  avg_stay_minutes int       [null, note: '[Mock] 도착지 요약 정보 2/3 — 머무는 시간(분). 다른 기사들이 이 센터에 머문 평균 시간이며 상하차 대기를 포함한다. 실서비스는 방문·정차 데이터 기반 산출 전제. 근거: 기획서 8-5']
  handled_items    varchar   [null, note: '[Mock] 도착지 요약 정보 3/3 — 취급 품목. 단일 문자열이며 쉼표로 구분해 표시한다. 예: 생활용품, 가전 (2026-08-13 확정, 구 미정 29). 근거: 기획서 8-5']
  created_at       timestamp [not null]
  deleted_at       timestamp [null]

  Note: '''
  [실동작 + Mock 혼재]
  센터 자체 정보는 시드 데이터, visit_count는 트럭커 연동 전제 Mock이다.
  관리자 화면에서 visit_count를 표시할 때는 Mock임을 화면에 표시한다
  (근거: 기획서 12-1, 20-16 / AGENTS.md 아키텍처 규칙).

  화물센터 1 : N 주변 장소 관계로 관리한다 (근거: 기획서 18-8).

  ── 도착지 요약 정보 3종 (v2.4 신설)
  물류 원가 / 머무는 시간 / 취급 품목은 암묵지가 아니라 센터 운영 데이터다.
  실서비스는 카카오 T 트럭커 연동 또는 센터 마스터 데이터를 전제로 하고,
  MVP에서는 시드 JSON의 Mock 값으로 표시한다 (근거: 기획서 8-5, 18-6, 18-확정 26).
  지도 화면(S-03)에 이 세 줄을 함께 보여주며 경로는 표시하지 않는다.

  단위 확정 (2026-08-13, 구 미정 29):
    logistics_cost   원   이 센터 1회 운송의 평균 물류 원가
    avg_stay_minutes 분   상하차 대기를 포함한 평균 체류 시간
    handled_items    쉼표로 구분한 단일 문자열. 예: 생활용품, 가전

  세 컬럼 모두 nullable을 유지한다. 값이 비어도 화면이 빈 상태로 동작해야 한다.
  값은 전량 시연용 Mock이며 실제 센터 운영 데이터가 아니다. 화면에 Mock 배지를 붙인다.
  '''
}


// =============================================================
// 3. place — 도착지 주변 장소 (주유소 / 식당 / 휴게소·쉼터)
// =============================================================

Table place {
  id                varchar       [pk]
  center_id         varchar       [not null, note: '소속 화물센터. 화물센터 1:N 장소. 근거: 기획서 18-확정 8']
  name              varchar       [not null, note: '장소명. 예: 군포하나로주유소']
  category          card_category [not null, note: 'gas / food / rest 만 사용한다. center_tip은 장소가 아니라 센터 자체이므로 place에 오지 않는다']
  lat               decimal       [not null, note: '지도 마커 좌표']
  lng               decimal       [not null, note: '지도 마커 좌표']
  visit_count       int           [not null, default: 0, note: '[Mock][캐시] 방문·정차 횟수. 인터뷰 후보 선정 입력이자 관리자 ADM-03 표시값. 근거: 기획서 12, 18-13']
  created_at        timestamp     [not null]
  deleted_at        timestamp     [null]

  Note: '''
  [실동작 + Mock 혼재]
  수집 대상 장소는 주유소·식당·휴게소·쉼터 네 범위로 한정한다
  (근거: 기획서 7-1, 18-11). 일반 도로·경로 관련 장소는 넣지 않는다.

  category에 card_category enum을 재사용하는 이유:
  카테고리 정의를 두 곳에 두면 어긋나기 때문이다. 대신 center_tip 값은
  place에서 사용하지 않는다는 제약을 애플리케이션에서 지킨다.
  → 별도 place_category enum으로 분리할지는 [미정: 16]
  '''
}


// =============================================================
// 4. dispatch — 배차·운행
// =============================================================

Table dispatch {
  id                varchar   [pk]
  driver_id         varchar   [not null, note: '운행한 기사']
  center_id         varchar   [not null, note: '도착 화물센터. S-02에서 선택한 값']
  origin_label      varchar   [null, note: '출발지 표시 문자열. 기본값은 현재 위치다. 근거: 기획서 6-1 ①, 18-확정 24']
  origin_lat        decimal   [null, note: '출발지 좌표. 지도 화면(S-03)의 출발지 마커 표시용. 근거: 기획서 8-5']
  origin_lng        decimal   [null, note: '출발지 좌표']
  started_at        timestamp [null, note: '기사가 `운행 시작` 버튼을 선택한 시각. dispatch 생성 시점과 다르므로 nullable이다. 근거: 기획서 6-1 ④, 18-확정 23']
  ended_at          timestamp [null, note: '기사가 도착지에 도달한 시각(운행 종료 이벤트). 이 값이 채워지는 순간이 인터뷰 생성·노출 트리거다. MVP는 `운행 종료` 버튼으로 재현한다. 근거: 기획서 6-1 ⑥, 7-5, 18-확정 14']
  created_at        timestamp [not null, note: '도착지를 확정해 이 운행을 만든 시각']

  Note: '''
  [Mock] 배차·위치·운행 데이터는 카카오 T 트럭커 연동 전제다
  (근거: 기획서 12-1, 18-21). MVP에서는 시연 화면의 `운행 종료` 버튼으로
  ended_at을 채워 동일한 흐름을 재현한다.

  ── 운행 상태는 파생값이다 (v2.4)
    created_at만 있음            도착지 확정, 운행 전 (브리핑·지도 탐색 단계)
    started_at 있음, ended_at 없음  운행 중 (현재 위치 기반 조회 가능)
    ended_at 있음                 운행 종료 (인터뷰 생성·노출)

  dispatch_status 같은 ENUM을 만들지 않는다. 기획서에 상태값 정의가 없고
  두 시각 컬럼으로 전부 판정되기 때문이다.

  ── 출발지를 저장하되 경로에는 쓰지 않는다
  출발지·도착지는 운행 여정 관리와 지도 표시에만 쓴다. 경로 계산·경로 추천에
  사용하지 않는다 (근거: 기획서 6-1 ①, 18-확정 22·24). 지도에 경로선을 그리지 않는다.

  ── 운행 중 현재 위치는 저장하지 않는다
  현재 위치는 트럭커가 제공하는 실시간 값이고 (기획서 18-6 트럭커 연동 데이터),
  MVP에서는 Mock 좌표를 화면 상태로만 다룬다. 위치 이력 테이블을 만들지 않는다.
  기획서에 위치 이력을 보관한다는 요구가 없고, 만들면 경로 데이터를 쌓는 구조가
  되어 18-확정 12·22와 정면으로 어긋난다.

  ── 설계 판단: 운행 종료를 왜 trigger_event에 넣지 않았는가
  기획서 7-1은 "인터뷰 후보 선정 기준"과 "인터뷰 생성·노출 트리거"를
  명시적으로 구분하라고 정한다. trigger_type enum에는 반복 방문·정차만 있고
  운행 종료는 없다. 운행 종료를 trigger_event 행으로 만들면 두 개념이
  한 테이블에 섞여 기획서의 구분이 깨진다.
  따라서 후보는 trigger_event에, 노출 시점은 dispatch.ended_at에 둔다.
  → 이 배치를 확정할지는 [미정: 17]

  이 테이블 없이 안 되는 것: 하나의 운행에 속한 인터뷰 후보들을 묶을 수 없고,
  S-03의 `운행 시작`·`운행 종료` 버튼이 무엇을 시작·종료하는지 지칭할 대상이 사라진다.
  출발지·도착지 입력(S-02)의 결과를 담을 곳도 없어진다.
  '''
}


// =============================================================
// 5. trigger_event — 인터뷰 후보
// =============================================================

Table trigger_event {
  id          varchar      [pk]
  dispatch_id varchar      [not null, note: '어느 운행에서 감지했는가']
  place_id    varchar      [null, note: '후보 장소. 센터 자체가 대상이면 null']
  type        trigger_type [not null, note: 'repeat_visit / repeat_stop. 근거: 기획서 18-13']
  detected_at timestamp    [not null, note: '후보 감지 시각. 운행 중이며, 이 시점에는 사용자에게 노출하지 않는다']
  created_at  timestamp    [not null]

  Note: '''
  [Mock] 위치·방문·정차 데이터 기반 감지 결과.

  ── 핵심 규칙
  운행 중에는 후보만 감지·저장하고 인터뷰를 노출하지 않는다
  (근거: 기획서 7-1, 7-5). 노출은 기사가 도착지에 도달해
  dispatch.ended_at이 채워진 뒤다.

  운행 중 기사가 커뮤니티(가칭) 화면을 열어 현재 위치 기준 암묵지를 조회하는 것은
  이 흐름과 무관하다. 조회는 소비이고 후보 감지는 수집이다 (근거: 기획서 8-6, 7-5).

  place_id가 null이면 도착 화물센터 자체에 대한 후보다.
  이 경우 소속 센터는 dispatch.center_id로 따라간다.

  임계값(반복 N회)은 [미정: 6]. 이 테이블은 판정 결과만 저장하고
  판정 로직 자체는 담지 않는다.

  이 테이블 없이 안 되는 것: S-03의 "인터뷰 후보 감지 표시"와
  DRV-08의 "저장된 후보로 인터뷰 생성"이 성립하지 않는다.
  '''
}


// =============================================================
// 6. interview — AI 인터뷰
// =============================================================

Table interview {
  id               varchar   [pk]
  driver_id        varchar   [not null, note: '응답 기사']
  dispatch_id      varchar   [not null, note: '어느 운행 종료로 생성되었는가']
  trigger_event_id varchar   [not null, note: '어느 후보에서 생성되었는가. 후보 1건 : 인터뷰 1건. 운행 종료 시 후보가 복수여도 1건만 선정하므로 이 관계가 유지된다. 근거: 기획서 7-1']
  is_rewarded      boolean   [not null, default: false, note: '기본 기여 보상(+100P) 지급 여부. 인터뷰 1회당 1번만 지급하기 위한 잠금. 근거: 기획서 9-4, 18-4']
  extra_reward_sum int       [not null, default: 0, note: '[캐시] 이 인터뷰에서 누적 지급한 extra_reward 합계. 상한 +50P 판정용. 정본은 point_transaction. 근거: 기획서 9-5']
  created_at       timestamp [not null, note: '인터뷰 생성·노출 시각']

  Note: '''
  [실동작]

  ── 포인트 정책이 이 테이블에 걸려 있다
  기본 기여 적립(interview_reward)은 카드가 아니라 interview를 참조한다.
  AI가 답변을 여러 카드로 분리해도 기본 보상은 1회다 (근거: 기획서 18-1, AGENTS.md).
  is_rewarded가 그 잠금 역할을 한다.

  ── 후보가 복수일 때 (팀 확정)
  운행 종료 시 저장된 후보 중 반복 횟수가 가장 많은 1건만 인터뷰로 만든다.
  동점이면 가장 최근 감지된 후보. 무작위 선택은 하지 않는다.
  따라서 dispatch 1건에 interview는 최대 1건이며,
  기본 기여 보상은 운행당 +100P를 넘지 않는다.
  선택되지 않은 후보는 trigger_event 행으로 남되 인터뷰를 만들지 않는다.
  근거: 기획서 7-1 "후보가 여러 건일 때", AGENTS.md 인터뷰 트리거

  이 테이블 없이 안 되는 것: S-06 전체와 interview_reward의 참조 대상이 사라진다.
  '''
}


// =============================================================
// 7. interview_item — 인터뷰 질문·답변 1턴
// =============================================================

Table interview_item {
  id            varchar   [pk]
  interview_id  varchar   [not null]
  seq           int       [not null, note: '인터뷰 내 순서. 1부터']
  question_text text      [not null, note: '기사에게 제시한 질문 원문']
  is_followup   boolean   [not null, default: false, note: 'true면 AI가 부족 요소를 근거로 생성한 후속 질문. extra_reward 판정의 기준. 근거: 기획서 7-3 2단계, 9-5']
  stt_text      text      [null, note: '음성 답변의 STT 원문. AI 구조화 결과와 함께 관리자 화면에 병기한다. 근거: 기획서 7-4 마지막 문단']
  element_check json      [null, note: '[제안] 정보 요소 충족도 판정 결과. 예: {"place":true,"reason":true,"vehicle":false,"time":false}. S-06 3단계는 API 응답으로 즉시 표시하므로 미저장도 가능하다. 저장할지는 [미정: 18]']
  created_at    timestamp [not null]

  indexes {
    (interview_id, seq) [unique]
  }

  Note: '''
  [실동작]

  stt_text는 AI 비환각 원칙의 검증 근거다. 관리자 화면(ADM-04)에서
  이 원문과 knowledge_card의 구조화 결과를 반드시 함께 보여준다
  (근거: 기획서 7-4, 18-18).

  STT 실패·음성 미지원 시 텍스트 입력으로 대체한 값도 이 컬럼에 담는다
  (근거: 기획서 7-2). 입력 수단을 구분해 저장할지는 [미정: 19].

  기본 질문의 출처(템플릿 고정 vs AI 생성)는 [미정: 3]이므로
  question_source 같은 컬럼을 미리 만들지 않는다.
  후속 질문이 AI 생성이라는 점만 확정이므로 is_followup만 둔다.

  이 테이블 없이 안 되는 것: S-06의 후속 질문 흐름과 관리자 화면의
  "원본 STT + 구조화 결과 병기"가 불가능하다.
  '''
}


// =============================================================
// 8. knowledge_card — 지식 카드 (암묵지 카드)
// =============================================================

Table knowledge_card {
  id                varchar       [pk]
  author_driver_id  varchar       [not null, note: '작성자. 자기 카드 평가 제한 판정에 사용. 시드 카드도 Mock 기사를 참조한다']
  interview_item_id varchar       [null, note: '이 카드를 만든 답변 1턴. 시드 카드는 인터뷰가 없으므로 null']
  center_id         varchar       [not null, note: '관련 화물센터. 도착 센터 기준 조회(S-04)를 위해 비정규화해 둔다. place가 있으면 place.center_id와 같아야 한다']
  place_id          varchar       [null, note: '관련 장소. category가 center_tip이면 null, 그 외에는 값이 있어야 한다. AI가 반환한 placeName이 아니라 요청에 실어 보낸 place.id를 쓴다 (미정 27 해소, docs/API.md A-2)']
  category          card_category [not null, note: '근거: 기획서 8-1, 18-확정 11']
  status            card_status   [not null, default: 'draft', note: '근거: 기획서 18-확정 4. 기사 목록에는 published만 노출한다']
  title             varchar       [not null, note: 'AI가 구조화한 한 줄 핵심 정보. 잠금 상태에서도 노출된다. 근거: 기획서 20-3']
  reason            text          [null, note: '추천·비추천 이유. 원문에 근거가 없으면 비워 둔다. MVP의 시드·API는 빈 문자열, DB 전환 시 NULL. 근거: 기획서 7-4, 18-확정 18 (비환각 원칙)']
  stt_text          text          [null, note: '이 카드의 근거가 된 음성 원문. interview_item.stt_text가 정본이지만, 시드 카드는 인터뷰가 없어 여기에 직접 담는다. 관리자 화면 ADM-04의 원본 병기에 쓴다. 근거: 기획서 7-4 마지막 문단']
  helpful_count     int           [not null, default: 0, note: '[캐시] 도움됐어요 수. 정본은 evaluation']
  not_helpful_count int           [not null, default: 0, note: '[캐시] 도움 안 됐어요 수. 정본은 evaluation. review 자동 전환 판정 입력']
  cross_check_count int           [not null, default: 0, note: '[캐시] 교차 검증 연결 수. 정본은 card_relation. 관리자 화면 표시값. 근거: 기획서 13-3']
  created_at        timestamp     [not null, note: '작성일. 화면에 표시한다. 예: 작성: 2026.08.12. 근거: 기획서 10-4, 18-5, 18-20']
  updated_at        timestamp     [not null]
  reviewed_at       timestamp     [null, note: '관리자가 검토 완료 조치를 한 시각. status는 review에서 published로 되돌리며 새 상태값을 만들지 않는다. 근거: 기획서 13-3, AGENTS.md 품질']
  deleted_at        timestamp     [null, note: 'Soft Delete. status=deleted와 함께 채운다. 물리 삭제하지 않는다. 근거: 기획서 18-확정 7']

  indexes {
    (center_id, status)
    (place_id, status)
  }

  Note: '''
  [실동작] 서비스의 중심 테이블.

  ── 카드 1개 = 하나의 주장 또는 하나의 현장 팁 (근거: 기획서 18-1)
  AI는 한 답변을 여러 카드로 분리할 수 있다. 그래도 기본 보상은
  interview 단위로 1회다.

  ── 비환각 원칙이 스키마에 반영된 지점
  reason은 nullable이다. 원문에 이유가 없으면 지어내지 않고 비워 둔다
  (근거: 기획서 7-4, 18-18). "차 세우기 괜찮아요"를
  "11톤 트럭까지 여유롭게 주차 가능"으로 채우면 안 된다.

  ── 최근확인일을 두지 않는 이유
  MVP는 created_at만 저장·표시한다. 최근확인일·자동 만료·자동 삭제는
  사용하지 않는다 (근거: 기획서 10-4, 18-5, 18-20).

  ── 무료 카드 정책 (#1 해소: 전부 10P 잠금)
  팀 결정으로 모든 카드가 10P 잠금이다. 무료 카드가 없으므로
  is_free / is_seed 컬럼을 만들지 않는다. 가입 축하 +100P가 체험권 역할을 한다
  (10장). 무료 카드를 두면 시연 3단계(10P 해금)와 4단계(잔액 0P)가 성립하지 않는다.

  ── 정렬 [미정: 2]
  목록 정렬 기준이 미정이므로 score / distance 같은 컬럼을 미리 두지 않는다.
  '''
}


// =============================================================
// 9. card_relation — 교차 검증 연결  [제안]
// =============================================================

Table card_relation {
  id             varchar       [pk]
  source_card_id varchar       [not null, note: '새로 구조화된 카드']
  target_card_id varchar       [not null, note: '동일 장소에 이미 존재하던 카드']
  type           relation_type [not null, note: 'similar = 교차 검증 연결 / conflict = 충돌 보존. 근거: 기획서 7-3 4단계, 11-2']
  created_at     timestamp     [not null]

  indexes {
    (source_card_id, target_card_id) [unique]
  }

  Note: '''
  [제안] AGENTS.md의 엔티티 목록 11개에는 이 테이블이 없다.
  그러나 교차 검증은 기획서 11장·18-17·18-19의 확정 정책이고,
  관리자 화면은 "교차 검증 수"를 표시해야 한다 (기획서 13-3).
  저장할 곳이 없으면 그 화면이 성립하지 않으므로 추가를 제안한다.
  → 채택 여부 [미정: 20]

  이 테이블 없이 안 되는 것: 관리자 화면(S-08)의 교차 검증 연결 현황(ADM-09)과
  카드 상세(S-05)의 교차 검증 표시(DRV-17)를 만들 수 없다.

  ── AI 응답의 relation 4종과 이 테이블의 관계 (docs/API.md A-4)
  AI는 new / similar / conflict / duplicate 를 반환한다.
  이 테이블에 행이 생기는 것은 similar 와 conflict 뿐이다.
  new는 관계 없음이고, duplicate는 카드 자체를 만들지 않는다.
  따라서 relation_type enum은 2종 그대로 유지한다 (AGENTS.md ENUM 규칙).
  knowledge_card에 자기참조 FK 한 개를 두는 대안도 있으나,
  그 방식으로는 similar와 conflict를 구분할 수 없고 다대다 관계도 담지 못한다.

  ── 반드시 지킬 규칙
  이 테이블은 관계만 저장한다. AI가 유사하다고 판단했다는 이유로
  기존 카드를 자동 삭제하거나 병합하지 않는다.
  원본 경험은 각자의 knowledge_card 행으로 보존한다
  (근거: 기획서 7-3 4단계 마지막 문단, 11-2, 18-19).

  비교 범위는 동일 장소·화물센터로 제한한다 (근거: 기획서 11-2).
  '''
}


// =============================================================
// 10. evaluation — 도움 평가
// =============================================================

Table evaluation {
  id                varchar    [pk]
  driver_id         varchar    [not null, note: '평가자']
  knowledge_card_id varchar    [not null]
  value             eval_value [not null, note: 'helpful / not_helpful']
  created_at        timestamp  [not null]
  updated_at        timestamp  [not null, note: '평가 변경이 허용되므로 갱신 시각을 남긴다. 근거: 기획서 18-확정 5']

  indexes {
    (driver_id, knowledge_card_id) [unique]
  }

  Note: '''
  [실동작]

  ── 평가 자격 (근거: 기획서 18-확정 5, 13-4)
  1. 해당 카드를 해금하여 내용을 열람한 사용자만 평가할 수 있다
     → unlock에 행이 존재해야 한다
  2. 카드당 1회. 변경은 가능 → unique 인덱스 + update
  3. 자기가 작성한 카드는 평가할 수 없다
     → driver_id != knowledge_card.author_driver_id

  세 조건 모두 애플리케이션(lib/store.js)에서 검증한다.

  ── review 자동 전환 (근거: 기획서 13-4, 18-확정 6)
  이 테이블의 집계로 판정한다.
    조건 1: not_helpful 5건 이상
    조건 2: 전체 평가 5건 이상 AND 부정 평가율 60% 이상
  둘 중 하나를 충족하면 knowledge_card.status를 review로 바꾼다.
  조건 2의 최소 표본 5건은 표본이 적을 때 부정률만으로 전환되는 것을 막는 장치다.

  이 테이블 없이 안 되는 것: S-05의 도움 평가와 관리자 검토 대상 자동 분류(ADM-06).
  '''
}


// =============================================================
// 11. unlock — 암묵지 해금
// =============================================================

Table unlock {
  id                varchar   [pk]
  driver_id         varchar   [not null, note: '해금한 기사']
  knowledge_card_id varchar   [not null, note: '해금한 카드']
  created_at        timestamp [not null, note: '최초 해금 시각']

  indexes {
    (driver_id, knowledge_card_id) [unique]
  }

  Note: '''
  [실동작]

  ── 해금 규칙 (근거: 기획서 9-6, 18-확정 1)
  카드 1건 단위로 해금하며 최초 해금 시에만 -10P를 차감한다.
  재열람은 무료이고 환불은 없다. unique 인덱스가 중복 차감을 막는다.

  이 테이블은 "평가 자격"의 근거이기도 하다. 해금 행이 없으면 평가할 수 없다
  (근거: 기획서 18-확정 5).

  잔액 부족으로 해금하지 못한 시도는 저장하지 않는다.
  실패한 시도까지 남길 이유가 기획서에 없다.

  이 테이블 없이 안 되는 것: S-05의 잠금·해금 상태 구분,
  재열람 무료 판정, 평가 자격 판정이 전부 불가능하다.
  '''
}


// =============================================================
// 12. point_transaction — 포인트 적립·차감 이력
// =============================================================

Table point_transaction {
  id                varchar       [pk]
  driver_id         varchar       [not null]
  type              point_tx_type [not null]
  amount            int           [not null, note: '적립은 양수, 차감은 음수. signup_bonus +100 / interview_reward +100 / extra_reward +10 / unlock_spend -10']
  interview_id      varchar       [null, note: 'type=interview_reward일 때만 채운다. 기본 기여는 카드가 아니라 인터뷰를 참조한다. 근거: AGENTS.md 데이터 모델 절']
  knowledge_card_id varchar       [null, note: 'type=extra_reward 또는 unlock_spend일 때만 채운다. 카드 단위 참조']
  created_at        timestamp     [not null]

  indexes {
    (driver_id, created_at)
  }

  Note: '''
  [실동작] 포인트의 정본. driver.point_balance는 이 테이블의 캐시다.

  ── 타입별 참조 대상
    signup_bonus     : 둘 다 null
    interview_reward : interview_id       (기여 1회 = +100P)
    extra_reward     : knowledge_card_id  (추가로 생성된 카드 단위)
    unlock_spend     : knowledge_card_id  (해금한 카드)

  ── 중복 지급 방지
    signup_bonus     : driver당 1행 (애플리케이션에서 검증)
    interview_reward : interview.is_rewarded로 잠금
    extra_reward     : interview.extra_reward_sum이 50에 도달하면 더 적립하지 않는다
    unlock_spend     : unlock의 unique 인덱스가 보장

  ── 적립 사유는 이 4개가 전부다
  기획서 9-1의 4줄 외에 다른 적립·차감 사유를 추가하지 않는다.
  음성 길이·글자 수·말한 시간으로 보상하지 않는다 (근거: 기획서 9-5).

  이 테이블 없이 안 되는 것: S-07 포인트·기여 내역 전체와
  S-01의 가입 축하 포인트 기록.
  '''
}


// =============================================================
// 관계 정의
// =============================================================

Ref: place.center_id                     > freight_center.id
Ref: dispatch.driver_id                  > driver.id
Ref: dispatch.center_id          > freight_center.id
Ref: trigger_event.dispatch_id           > dispatch.id
Ref: trigger_event.place_id              > place.id
Ref: interview.driver_id                 > driver.id
Ref: interview.dispatch_id               > dispatch.id
Ref: interview.trigger_event_id          - trigger_event.id
Ref: interview_item.interview_id         > interview.id
Ref: knowledge_card.author_driver_id     > driver.id
Ref: knowledge_card.interview_item_id    > interview_item.id
Ref: knowledge_card.center_id            > freight_center.id
Ref: knowledge_card.place_id             > place.id
Ref: card_relation.source_card_id        > knowledge_card.id
Ref: card_relation.target_card_id        > knowledge_card.id
Ref: evaluation.driver_id                > driver.id
Ref: evaluation.knowledge_card_id        > knowledge_card.id
Ref: unlock.driver_id                    > driver.id
Ref: unlock.knowledge_card_id            > knowledge_card.id
Ref: point_transaction.driver_id         > driver.id
Ref: point_transaction.interview_id      > interview.id
Ref: point_transaction.knowledge_card_id > knowledge_card.id


// =============================================================
// 부록 A. 시드 JSON 대응
//
// AGENTS.md 파일 구조의 data/*.json 4개와 이 ERD의 대응이다.
// 시드 JSON은 snake_case 단수형 필드를 그대로 쓰고,
// lib/dataSource.js에서 camelCase로 1회만 변환한다.
//
//   data/drivers.json  →  driver
//   data/centers.json  →  freight_center
//   data/places.json   →  place
//   data/cards.json    →  knowledge_card  (interview_item_id = null)
//
// centers.json의 요약 3종(logistics_cost / avg_stay_minutes / handled_items)은
// #29 확정(2026-08-13)에 따라 시연용 Mock 값을 채운다. 세 컬럼은 nullable을 유지하며
// 값이 비어도 화면이 빈 상태로 동작해야 한다.
//
// 시드가 없는 테이블은 런타임에 인메모리로 생성한다.
//   dispatch          : S-02에서 출발지·도착지를 확정할 때 생성
//                       (started_at은 `운행 시작`, ended_at은 도착지 도달 시점에 채운다)
//   trigger_event     : Mock 방문 데이터로 생성
//   interview         : dispatch.ended_at이 채워질 때 생성
//   interview_item    : 질문·답변마다 생성
//   card_relation     : AI 유사도 판단 결과로 생성
//   evaluation        : 도움 평가 시 생성
//   unlock            : 해금 시 생성
//   point_transaction : 적립·차감 시 생성
//
// 공공데이터는 런타임에 호출하지 않는다. 사전 덤프만 사용하며
// 출처는 data/README.md에 기록한다 (AGENTS.md 기술 스택).
//
//
// 부록 B. 파생값 캐시 목록
//
// 캐시가 정본과 어긋나면 정본이 옳다. 갱신은 lib/store.js에서만 한다.
//
//   driver.point_balance             ← point_transaction.amount 합계
//   interview.extra_reward_sum       ← point_transaction (type=extra_reward) 합계
//   knowledge_card.helpful_count     ← evaluation (value=helpful) 건수
//   knowledge_card.not_helpful_count ← evaluation (value=not_helpful) 건수
//   knowledge_card.cross_check_count ← card_relation (type=similar) 건수
//   freight_center.visit_count       ← [Mock] 정본 없음. 하드코딩 값
//   place.visit_count                ← [Mock] 정본 없음. 하드코딩 값
//   freight_center.avg_stay_minutes  ← [Mock] 실서비스에서는 방문·정차 데이터 기반 산출.
//                                       MVP는 시드 하드코딩 (기획서 8-5)
//   freight_center.logistics_cost / handled_items
//                                    ← [Mock] 정본 없음. 시드 하드코딩 (원 / 쉼표 구분 문자열)
//
//
// 부록 C. 미정 항목
//
// 임의 결정 금지. 번호는 AGENTS.md 미결정 절 / docs/기능명세서.md 14장과 공유한다.
// 추가·해소 시 AGENTS.md를 먼저 고친다. 자동으로 읽히는 파일은 AGENTS.md뿐이다.
//
//   ── v2.4 신설 (기획서 8-5, 8-6)
//
//   #29 해소됨 (2026-08-13). logistics_cost = int 원 단위(1회 운송 평균 물류 원가),
//       avg_stay_minutes = int 분 단위(상하차 대기 포함),
//       handled_items = varchar 단일 문자열(쉼표 구분). 세 컬럼 모두 nullable을 유지한다.
//       값은 전량 시연용 Mock이며 실제 센터 운영 데이터가 아니다.
//   #30 운행 중 조회 화면의 명칭·경로·진입 방식 → 화면 판단. 스키마 영향 없음
//   #31 현재 위치 기반 갱신 기준(반경·정렬·갱신 시점) → 화면 판단. 스키마 영향 없음.
//       거리 계산은 lib/distance.js가 좌표로 수행하며 저장 대상이 아니다
//
//   남은 미정 9건은 전부 화면 설계 판단이며 이 스키마에 영향을 주지 않는다.
//   목록의 정본은 AGENTS.md 미결정 절이다.
//
//   ── 2026-08-12 일괄 해소 (근거: ai/ 산출물 + 골든 테스트 12/12 + 팀 결정)
//
//   #1  무료 카드 정책 → **전부 10P 잠금.** is_free / is_seed 컬럼을 만들지 않는다
//   #13 관리자 접근 제어 → 인증을 만들지 않는다. 스키마 영향 없음
//
//   #2  목록 정렬  → 정렬용 컬럼을 두지 않는다. FE가 메모리에서 정렬한다
//   #3  기본 질문  → 템플릿 고정. interview_item.question_source를 만들지 않는다
//   #6  트리거 임계값 → 당일 구현하지 않는다. 후보는 시드(drivers.json.repeat_visit)에 있다
//   #8  후보 복수  → 반복 횟수 최다 1건만. dispatch 1 : interview 최대 1. 스키마 변경 없음
//   #16 place.category → 별도 enum으로 분리하지 않는다. card_category 재사용 유지
//   #17 운행 종료  → dispatch.ended_at 배치 확정. 후보는 trigger_event, 노출은 dispatch
//   #18 충족도 판정 → interview_item.element_check에 **저장한다**. AI가 elementCheck로 반환
//   #19 STT 입력 수단 → 구분하지 않는다. 음성·텍스트 모두 stt_text에 담는다
//   #20 card_relation → **채택.** AI가 relation을 반환하므로 저장할 곳이 필요하다
//   #21~#23 해소됨 (기능명세서 v1.2~v1.4)
//   #23 결정: 검토 완료는 review → published 복귀. 상태값을 추가하지 않고
//            knowledge_card.reviewed_at에 검토 시각만 남긴다
//   #27 placeName → 저장에 쓰지 않는다. store가 요청의 place.id를 붙인다
//                   (knowledge_card.place_id note 참조)
//
//   전체 목록의 정본은 AGENTS.md 미결정 절이다.
//
//
// 부록 D. 변경 이력
//
//   v3.0  기획서 v2.4(운행 여정 화면 흐름) 반영.
//         ENUM은 하나도 바뀌지 않았고 테이블도 늘지 않았다. 컬럼 6개 추가와
//         제약 1개 완화가 전부다. 브리핑·운행 중 조회가 저장 구조를 늘리지 않기 때문이다.
//         - freight_center.logistics_cost / avg_stay_minutes / handled_items 추가
//           (도착지 요약 정보 3종. [Mock], 단위는 원 / 분 / 쉼표 구분 문자열)
//         - dispatch.origin_label / origin_lat / origin_lng 추가
//           (출발지. 지도 표시·여정 관리 전용, 경로 계산 금지)
//         - dispatch.started_at을 not null → null 로 완화
//           (dispatch 생성 시점 ≠ `운행 시작` 버튼 시점)
//         - dispatch.ended_at note를 "도착지 도달 시각"으로 재정의 (MVP는 버튼 재현)
//         - dispatch Note에 운행 상태 파생 규칙, 출발지 사용 제한,
//           현재 위치를 저장하지 않는 이유 추가
//         - Project Note에 운행 여정 ↔ 스키마 대응 추가
//         - 부록 A·B·C를 v2.4 기준으로 갱신, 미정 #29~#31 등록
//
//   v2.0  시드 실물(data/*.json)과 AI 산출물(ai/*)에 스키마를 맞춘 정합 개정.
//         이름의 정본은 여전히 이 파일이지만, 이미 동작하는 시드·프롬프트를
//         고치는 대신 이 문서를 현실에 맞췄다 (해커톤 8시간 기준 판단).
//         - place.freight_center_id      → center_id
//         - knowledge_card.freight_center_id → center_id
//         - knowledge_card.driver_id     → author_driver_id
//         - dispatch.freight_center_id   → center_id (일관성)
//         - freight_center.region        → address
//         - knowledge_card.stt_text 추가 (시드 카드는 interview_item이 없다)
//         - driver.age / career_years / base_region 추가 (기획서 페르소나)
//         - knowledge_card.reason: MVP는 빈 문자열, DB 전환 시 NULL로 note 보강
//         - card_relation에 AI relation 4종과의 대응 설명 추가
//         - card_relation Note의 ADM-08 오타를 ADM-09로 정정
//         - 부록 C 미정을 일괄 해소, 잔여 1건(#1)
//
//   v1.4  docs/API.md v1.0 작성 과정에서 발견한 미정 #27을 부록 C에 추가.
//         API가 반환하는 placeName과 knowledge_card.place_id NOT NULL 제약이
//         충돌할 수 있다. 스키마 변경 없음 — 주석만 갱신.
//
//   v1.0  기획서 v2.3 / 기능명세서 v1.0 기준 최초 작성.
//         AGENTS.md 엔티티 11개 + card_relation 1개 제안, ENUM 6종,
//         파생값 캐시 7개 명시, 미정 10건 정리.
//
//   v1.1  DBML 문법 오류 수정 — Enum 블록 안의 Note는 허용되지 않으므로
//         6건을 Enum 선언 위의 주석으로 옮겼다. @dbml/cli 파싱 통과 확인.
//         근거 표기를 18-확정 N(확정사항 표) / 18-N(하위 절)로 분리.
//         18장에 두 체계가 함께 있어 기존 표기가 중의적이었다.
//
//   v1.3  팀 합의로 미정 8 해소. 운행 종료 시 후보가 복수여도 반복 횟수
//         최다 1건만 인터뷰로 만든다. dispatch 1 : interview 최대 1이 되어
//         포인트 상한이 유지된다. 스키마 변경 없음 — 주석만 갱신.
//
//   v1.2  팀 합의로 미정 23 해소. knowledge_card.reviewed_at 추가.
//         관리자 검토 완료는 review → published 복귀이며 card_status enum은
//         바꾸지 않는다 (AGENTS.md 품질, 기획서 13-3).
// =============================================================
